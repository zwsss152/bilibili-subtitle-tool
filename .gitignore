# ---- Python 缓存 ----
__pycache__/
*.pyc
*.pyo

# ---- 虚拟环境（依赖通过 requirements.txt 安装，不入库）----
.venv/
venv/
env/

# ---- 语音识别模型（首次运行自动下载，约 480MB+，勿入库）----
models/

# ---- 音频缓存（转写完成后自动删除，可能含用户下载的音频）----
asr_cache/

# ---- 临时 / 日志 ----
*.part
*.log
.DS_Store
文字稿/

# ---- UI 验证截图（本地调试产物，不入库）----
ui_preview.png

# ---- 图标生成中间产物（仅保留最终 .ico）----
assets/icon_preview.png
assets/Modern_flat_app_icon_for_a_vid_*.png
